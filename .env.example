# 尘龙 ChenLong 环境变量示例
# 复制为 .env 后填写真实值；.env 已被 .gitignore 忽略，切勿提交。

# 服务监听端口
PORT=3000

# 运行环境：development | production
NODE_ENV=development

# 会话签名密钥，生产环境必填（任意足够长的随机字符串）
# 生成方式：node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
SESSION_SECRET=

# AES-256-GCM 加密密钥，用于加密 API Key，32 字节
# 支持 64 位 hex 或 base64；生成方式：
# node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
ENCRYPTION_KEY=

# 初始管理员账号：仅在数据库内不存在任何 admin 时创建一次
# 留空则不创建；创建后请登录立即修改密码
ADMIN_USERNAME=admin
ADMIN_PASSWORD=

# PostgreSQL 连接串（推荐方式）
# 本地先用 docker compose up -d db 起数据库，再填：
# DATABASE_URL=postgres://chenlong:chenlong_dev_password@127.0.0.1:5432/chenlong
DATABASE_URL=

# 或者使用标准 PG* 环境变量（DATABASE_URL 为空时生效）
# PGHOST=127.0.0.1
# PGPORT=5432
# PGUSER=chenlong
# PGPASSWORD=
# PGDATABASE=chenlong
# 连接池上限（默认 10）
# PG_POOL_MAX=10

# docker compose 初始化 PostgreSQL 容器时使用（生产请改成强密码）
POSTGRES_USER=chenlong
POSTGRES_PASSWORD=change_me_in_env
POSTGRES_DB=chenlong

# 反向代理：仅在可信反代（Nginx/Caddy/ALB）之后开启，值为 1/true/yes/on
# 开启后 req.ip / req.secure 会采信一层 X-Forwarded-For / X-Forwarded-Proto；
# 服务若可被绕过反代直连，攻击者可伪造 X-Forwarded-For 轮换限流 key，请谨慎开启
# TRUST_PROXY=1

# 限流开关：仅开发环境有效（0/false 关闭）；生产环境强制开启
# RATE_LIMIT_ENABLED=0

# 允许上游地址使用内网/回环网段：仅开发环境有效（1/true 放行）；生产环境强制拒绝
# ALLOW_PRIVATE_UPSTREAM=1

# 聊天流式空闲超时（毫秒）：上游建连成功后多久没有数据就中断，默认 60000
# CHAT_STREAM_IDLE_TIMEOUT_MS=60000
